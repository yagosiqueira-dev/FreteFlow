POSTGRES_DB=freteflow
POSTGRES_USER=
POSTGRES_PASSWORD=
# Database roles for application access
# Spring Boot runtime uses freteflow_runtime; Flyway uses freteflow_migrator.
# Keep real credentials local; never commit them.
FRETEFLOW_RUNTIME_DB_USER=freteflow_runtime
FRETEFLOW_RUNTIME_DB_PASSWORD=
FRETEFLOW_MIGRATOR_DB_USER=freteflow_migrator
FRETEFLOW_MIGRATOR_DB_PASSWORD=

# Required by the application; provide a strong, unique value through your environment.
JWT_SECRET=
